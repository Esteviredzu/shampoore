  livekit:
    image: livekit/livekit-server:latest
    restart: unless-stopped
    command:
      - --config
      - /etc/livekit.yaml
    ports:
{{ if .LocalRelay }}      - "127.0.0.1:7880:7880"
{{ end }}      - "7881:7881"
      - "7882:7882/udp"
    volumes:
      - ./livekit.yaml:/etc/livekit.yaml:ro