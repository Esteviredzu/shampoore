services:
{{ if not .LocalRelay }}
  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
{{- range .Services }}
      - {{ .Name }}
{{- end }}
{{ end }}
{{- if .UsesAgent }}
  node-agent:
    image: debian:bookworm-slim
    restart: unless-stopped
    command:
      - /opt/shampoore/bin/shampoore-node-agent
    env_file:
      - ./agent.env
    volumes:
      - ./bin/shampoore-node-agent:/opt/shampoore/bin/shampoore-node-agent:ro
      - agent_state:/opt/shampoore/state
      - /etc/ssl/certs:/etc/ssl/certs:ro
{{ end }}
{{- range .Services }}
{{ printf "%s" .Compose }}
{{- end }}
{{ if or (not .LocalRelay) .UsesAgent }}volumes:
{{- if not .LocalRelay }}
  caddy_data:
  caddy_config:
{{- end }}
{{- if .UsesAgent }}
  agent_state:
{{- end }}
{{ end }}
