services:
  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - relay
      - livekit
      - minio

  relay:
    image: alpine:3.20
    restart: unless-stopped
    command:
      - /opt/shampoore/bin/shampoore-relay
      - -listen
      - ":8787"
      - -password
      - "{{ index .Secrets "raw_ws_password" }}"
    volumes:
      - ./bin/shampoore-relay:/opt/shampoore/bin/shampoore-relay:ro

  livekit:
    image: livekit/livekit-server:latest
    restart: unless-stopped
    command:
      - --config
      - /etc/livekit.yaml
    ports:
      - "7881:7881"
      - "7882:7882/udp"
    volumes:
      - ./livekit.yaml:/etc/livekit.yaml:ro

  minio:
    image: minio/minio:latest
    restart: unless-stopped
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: "{{ index .Secrets "minio_root_user" }}"
      MINIO_ROOT_PASSWORD: "{{ index .Secrets "minio_root_password" }}"
    volumes:
      - minio_data:/data

  minio-init:
    image: minio/mc:latest
    depends_on:
      - minio
    entrypoint:
      - /bin/sh
      - -c
    command:
      - |
        until mc alias set local http://minio:9000 "{{ index .Secrets "minio_root_user" }}" "{{ index .Secrets "minio_root_password" }}"; do sleep 1; done
        mc mb -p "local/{{ index .Secrets "s3_bucket" }}" || true

volumes:
  caddy_data:
  caddy_config:
  minio_data:
