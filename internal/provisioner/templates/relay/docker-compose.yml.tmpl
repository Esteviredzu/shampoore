services:
{{ if not .LocalRelay }}
  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
{{- range .Services }}
      - {{ .Name }}
{{- end }}
{{ end }}
{{- range .Services }}
{{ printf "%s" .Compose }}
{{- end }}
{{ if not .LocalRelay }}volumes:
  caddy_data:
  caddy_config:
{{ end }}
