[Unit]
Description=Shampoore panel and VPN server
Documentation=https://github.com/Esteviredzu/shampoore
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shampoore
Group=shampoore
WorkingDirectory=/var/lib/shampoore

EnvironmentFile=/etc/shampoore/panel.env

ExecStart=/opt/shampoore/bin/shampoore-panel \
    --listen=${PANEL_LISTEN} \
    --socket=/run/shampoore/shampoore.sock \
    --configs-dir=/var/lib/shampoore/configs \
    --db=${PANEL_DB} \
    --public-listen=${PUBLIC_LISTEN} \
    --public-url=${PUBLIC_URL} \
    --token=${PANEL_TOKEN} \
    --auto-start-server

Restart=always
RestartSec=3s
# The panel restarts itself with SIGTERM after installing an update.
SuccessExitStatus=SIGTERM

RuntimeDirectory=shampoore
RuntimeDirectoryMode=0750
StateDirectory=shampoore
StateDirectoryMode=0755

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
# The panel writes Caddy drop-ins for the subscription domain and local relay.
ReadWritePaths=-/etc/caddy

[Install]
WantedBy=multi-user.target